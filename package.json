{
  "name": "proyect_autonomo",
  "version": "1.0.0",
  "description": "AI Content Empire monorepo",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c cyan,magenta \"npm --prefix backend run start:dev\" \"npm --prefix frontend run dev\"",
    "build": "npm --prefix backend run build && npm --prefix frontend run build",
    "test": "npm --prefix backend run test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0Undertaker0/proyect_autonomo.git"
  },
  "keywords": [
    "ai",
    "agents",
    "content"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/0Undertaker0/proyect_autonomo/issues"
  },
  "homepage": "https://github.com/0Undertaker0/proyect_autonomo#readme",
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
